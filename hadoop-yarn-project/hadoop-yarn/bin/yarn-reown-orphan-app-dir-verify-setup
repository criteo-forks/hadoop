###############################################################################
#
# Verifies that yarn-reown-orphan-app-dir is deployed correctly, before the
# NodeManager is configured to use it.
#
# READ-ONLY. This script checks and reports; it never changes ownership,
# permissions, configuration or any file. It is safe to run at any time on a
# production node, and safe to re-run.
#
# Run as root:
#
#     /usr/libexec/hadoop-yarn/yarn-reown-orphan-app-dir-verify-setup
#
# Exits 0 only when every check passed, so it can gate a puppet run or a canary
# rollout. Each FAIL is followed by its remediation.
#
###############################################################################

set -uo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL

readonly PROG=yarn-reown-orphan-app-dir-verify-setup

# Defaults mirror yarn-reown-orphan-app-dir and the documented deployment.
REOWN_SCRIPT=/usr/libexec/hadoop-yarn/yarn-reown-orphan-app-dir
SUDOERS_FILE=/etc/sudoers.d/yarn-reown-orphan-app-dir
YARN_SITE=/etc/hadoop/conf/yarn-site.xml
OVERRIDE_FILE=/etc/yarn-reown-orphan-app-dir.conf
NM_USER=yarn
DO_SCAN=0

fails=0
warns=0

pass() { printf 'PASS  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*"; warns=$((warns + 1)); }
info() { printf 'INFO  %s\n' "$*"; }
fail() {
  printf 'FAIL  %s\n' "$1"
  shift
  # Remediation, indented under the failure it belongs to.
  local line
  for line in "$@"; do
    printf '      -> %s\n' "$line"
  done
  fails=$((fails + 1))
}

usage() {
  cat <<EOF
$PROG [options]

Verifies the deployment of yarn-reown-orphan-app-dir. Read-only: never changes
anything, safe to re-run on a production node. Must run as root, because it
reads the 0440 sudoers file and the 0700 re-own script.

Options:
  --script PATH      re-own script to verify (default $REOWN_SCRIPT)
  --sudoers PATH     sudoers drop-in to verify (default $SUDOERS_FILE)
  --yarn-site PATH   yarn-site.xml to verify (default $YARN_SITE)
  --nm-user USER     NodeManager run-as user (default $NM_USER)
  --scan             additionally count root-owned entries under each local
                     dir. Walks the disks, so it is opt-in.
  -h, --help         this message

Exit status: 0 when every check passed, 1 otherwise.
EOF
}

while [[ $# -gt 0 ]]; do
  case $1 in
    --script)    REOWN_SCRIPT=${2:?--script needs a value}; shift 2 ;;
    --sudoers)   SUDOERS_FILE=${2:?--sudoers needs a value}; shift 2 ;;
    --yarn-site) YARN_SITE=${2:?--yarn-site needs a value}; shift 2 ;;
    --nm-user)   NM_USER=${2:?--nm-user needs a value}; shift 2 ;;
    --scan)      DO_SCAN=1; shift ;;
    -h|--help)   usage; exit 0 ;;
    *)           printf '%s: unknown option: %s\n' "$PROG" "$1" >&2
                 usage >&2
                 exit 1 ;;
  esac
done

#
# Checks PATH and every ancestor are root-owned with no group/other write bit.
# Prints the first offender. Same rule the re-own script applies to its own
# configuration, and the same rule container-executor applies to its cfg.
#
first_untrusted_ancestor() {
  local cur uid mode depth=0
  # Resolve symlinks first, exactly as the re-own script does, so that the two
  # agree on a layout where a path component is a link.
  if ! cur=$(realpath -e -- "$1" 2>/dev/null); then
    printf '%s (cannot resolve)' "$1"
    return 1
  fi
  while :; do
    if (( ++depth > 64 )); then
      printf '%s (ancestor walk too deep)' "$cur"
      return 1
    fi
    if ! IFS=' ' read -r uid mode < <(stat -c '%u %a' "$cur" 2>/dev/null); then
      printf '%s (cannot stat)' "$cur"
      return 1
    fi
    if [[ $uid -ne 0 ]] || (( (0$mode & 0022) != 0 )); then
      printf '%s (uid %s mode %s)' "$cur" "$uid" "$mode"
      return 1
    fi
    [[ $cur == / ]] && break
    cur=$(dirname "$cur")
  done
  return 0
}

xml_property() {
  local key=$1
  xmllint --xpath \
    "string(/configuration/property[name='$key']/value)" "$YARN_SITE" 2>/dev/null
}

printf '%s: verifying yarn-reown-orphan-app-dir deployment (read-only)\n\n' \
  "$PROG"

# --- 1. running as root ------------------------------------------------------
if [[ $(id -u) -ne 0 ]]; then
  printf 'FAIL  must run as root\n'
  printf '      -> the 0440 sudoers file and the 0700 re-own script are not\n'
  printf '         readable otherwise; re-run with sudo\n'
  exit 1
fi
pass "running as root"

# --- 2. the re-own script ---------------------------------------------------
if [[ -L $REOWN_SCRIPT ]]; then
  fail "$REOWN_SCRIPT is a symlink" \
    "install the real file; a symlink means the target's ownership decides" \
    "what sudo executes as root"
elif [[ ! -f $REOWN_SCRIPT ]]; then
  fail "$REOWN_SCRIPT does not exist" \
    "install it from hadoop-yarn/bin/yarn-reown-orphan-app-dir" \
    "or pass --script with the path you deployed"
else
  script_owner=$(stat -c '%u:%g' "$REOWN_SCRIPT" 2>/dev/null)
  script_mode=$(stat -c '%a' "$REOWN_SCRIPT" 2>/dev/null)
  if [[ $script_owner != "0:0" ]]; then
    fail "$REOWN_SCRIPT is owned by $script_owner, expected 0:0" \
      "chown root:root $REOWN_SCRIPT" \
      "write access for anyone but root is arbitrary root code execution"
  else
    pass "$REOWN_SCRIPT is owned by root:root"
  fi
  if [[ $script_mode != "700" ]]; then
    if (( (0$script_mode & 0022) != 0 )); then
      fail "$REOWN_SCRIPT is group- or other-writable (mode $script_mode)" \
        "chmod 0700 $REOWN_SCRIPT" \
        "this is a root escalation, not a style issue"
    else
      warn "$REOWN_SCRIPT is mode $script_mode, expected 700 (not writable," \
           "so not a hole, but stricter is documented)"
    fi
  else
    pass "$REOWN_SCRIPT is mode 700"
  fi
fi

# --- 3. ancestors of the script ---------------------------------------------
if offender=$(first_untrusted_ancestor "$(dirname "$REOWN_SCRIPT")"); then
  pass "every ancestor of $REOWN_SCRIPT is root-owned and not group/other-writable"
else
  fail "an ancestor of $REOWN_SCRIPT is not trusted: $offender" \
    "a writable ancestor lets the script be replaced wholesale" \
    "do not deploy under \$HADOOP_HOME/bin, which is usually $NM_USER-owned"
fi

# --- 4. sudoers -------------------------------------------------------------
if [[ ! -f $SUDOERS_FILE ]]; then
  fail "$SUDOERS_FILE does not exist" \
    "create it with: $NM_USER ALL=(root) NOPASSWD: $REOWN_SCRIPT" \
    "then validate with visudo -cf $SUDOERS_FILE"
else
  sudoers_owner=$(stat -c '%u:%g' "$SUDOERS_FILE" 2>/dev/null)
  sudoers_mode=$(stat -c '%a' "$SUDOERS_FILE" 2>/dev/null)
  if [[ $sudoers_owner == "0:0" && $sudoers_mode == "440" ]]; then
    pass "$SUDOERS_FILE is root:root mode 440"
  else
    fail "$SUDOERS_FILE is $sudoers_owner mode $sudoers_mode, expected 0:0 440" \
      "chown root:root $SUDOERS_FILE && chmod 0440 $SUDOERS_FILE"
  fi
  if visudo -cf "$SUDOERS_FILE" >/dev/null 2>&1; then
    pass "$SUDOERS_FILE parses (visudo -cf)"
  else
    fail "$SUDOERS_FILE does not parse" \
      "run visudo -cf $SUDOERS_FILE to see the error" \
      "a broken drop-in can break sudo for every user on the node"
  fi
fi

if grep -Eq '^[[:space:]]*#includedir[[:space:]]+/etc/sudoers\.d' /etc/sudoers \
   2>/dev/null; then
  pass "/etc/sudoers includes /etc/sudoers.d"
else
  fail "/etc/sudoers does not include /etc/sudoers.d" \
    "add: #includedir /etc/sudoers.d" \
    "without it the drop-in above is never read"
fi

if sudo_rules=$(sudo -l -U "$NM_USER" 2>/dev/null); then
  if printf '%s' "$sudo_rules" | grep -Fq "$REOWN_SCRIPT"; then
    if printf '%s' "$sudo_rules" | grep -F "$REOWN_SCRIPT" \
        | grep -q 'NOPASSWD'; then
      pass "$NM_USER may run $REOWN_SCRIPT as root with NOPASSWD"
    else
      fail "$NM_USER may run $REOWN_SCRIPT but not with NOPASSWD" \
        "the NodeManager has no tty and cannot answer a password prompt" \
        "add NOPASSWD: to the rule"
    fi
  else
    fail "sudo does not resolve $REOWN_SCRIPT for $NM_USER" \
      "check the path in $SUDOERS_FILE matches $REOWN_SCRIPT exactly" \
      "sudo -l -U $NM_USER shows what it does resolve"
  fi
else
  warn "sudo -l -U $NM_USER failed; cannot confirm the rule resolves"
fi

if grep -rqs 'secure_path' /etc/sudoers /etc/sudoers.d 2>/dev/null; then
  pass "sudo has secure_path configured"
else
  warn "sudo has no secure_path; not exploitable here because the scripts use" \
       "an absolute shebang and pin PATH themselves, but setting it is" \
       "recommended"
fi

# --- 5/6. yarn-site.xml and local dirs --------------------------------------
if [[ ! -f $YARN_SITE ]]; then
  fail "$YARN_SITE does not exist" \
    "pass --yarn-site, or set YARN_SITE in $OVERRIDE_FILE for the re-own script"
else
  if offender=$(first_untrusted_ancestor "$YARN_SITE"); then
    pass "$YARN_SITE and its ancestors are root-owned, not group/other-writable"
  else
    fail "$YARN_SITE is not trusted: $offender" \
      "the re-own script REFUSES to read it, so the feature will not work" \
      "fix the ownership (chown root:root, chmod g-w,o-w); do not weaken the check" \
      "this is the check most likely to fail on a first deployment"
  fi
fi

if command -v xmllint >/dev/null 2>&1; then
  pass "xmllint is present"
else
  fail "xmllint not found" \
    "install libxml2; the re-own script aborts rather than regex-parsing XML"
fi

if command -v realpath >/dev/null 2>&1; then
  pass "realpath is present"
else
  fail "realpath not found" \
    "install coreutils; the re-own script resolves its configuration path" \
    "before checking that every ancestor is root-owned"
fi

# The re-own script exits 65 if this file exists and is not trusted, which is
# otherwise indistinguishable from an untrusted yarn-site.xml.
if [[ ! -e $OVERRIDE_FILE ]]; then
  info "no $OVERRIDE_FILE, so the built-in defaults apply"
elif offender=$(first_untrusted_ancestor "$OVERRIDE_FILE"); then
  pass "$OVERRIDE_FILE and its ancestors are root-owned, not group/other-writable"
else
  fail "$OVERRIDE_FILE is not trusted: $offender" \
    "the re-own script refuses to read it and exits 65 for every application" \
    "chown root:root $OVERRIDE_FILE && chmod g-w,o-w $OVERRIDE_FILE" \
    "or delete it if it is not needed"
fi

local_dirs_raw=""
if [[ -f $YARN_SITE ]] && command -v xmllint >/dev/null 2>&1; then
  local_dirs_raw=$(xml_property yarn.nodemanager.local-dirs)
  if [[ -z ${local_dirs_raw//[[:space:]]/} ]]; then
    fail "yarn.nodemanager.local-dirs is not set in $YARN_SITE" \
      "the re-own script derives every path from it and cannot run without it"
  else
    missing=0
    present=0
    # tr leaves no trailing newline, so without the || [[ -n ... ]] guard the
    # last entry - the only one on a single-local-dir node - is never seen.
    while IFS= read -r d || [[ -n $d ]]; do
      d=${d//[[:space:]]/}
      [[ -z $d ]] && continue
      d=${d#file://}
      if [[ -d $d ]]; then
        info "local dir $d"
        present=$((present + 1))
      else
        warn "local dir $d from $YARN_SITE is not a directory on this node"
        missing=$((missing + 1))
      fi
    done < <(printf '%s' "$local_dirs_raw" | tr ',' '\n')
    if [[ $present -eq 0 ]]; then
      fail "no yarn.nodemanager.local-dirs entry exists on this node" \
        "the re-own script has nothing to work on and exits 67" \
        "check the paths in $YARN_SITE resolve, and that none is written with an" \
        "unexpanded \${...} property reference, which the script cannot expand"
    elif [[ $missing -eq 0 ]]; then
      pass "every yarn.nodemanager.local-dirs entry exists"
    fi
  fi
fi

# --- 7/8. the NodeManager user ----------------------------------------------
if nm_uid=$(getent passwd "$NM_USER" | cut -d: -f3) && [[ -n ${nm_uid:-} ]]; then
  pass "NodeManager user $NM_USER resolves to uid $nm_uid"
  if [[ $nm_uid -eq 0 ]]; then
    fail "$NM_USER is uid 0" \
      "the re-own script uses SUDO_UID to re-own nmPrivate and rejects 0" \
      "the NodeManager must not run as root"
  fi
else
  fail "NodeManager user $NM_USER does not resolve" \
    "pass --nm-user with the account the NodeManager actually runs as"
fi

# --- 9. the NodeManager configuration ---------------------------------------
if [[ -f $YARN_SITE ]] && command -v xmllint >/dev/null 2>&1; then
  configured=$(xml_property yarn.nodemanager.orphaned-app-dirs.reown.command)
  enabled=$(xml_property yarn.nodemanager.orphaned-app-dirs.cleanup.enabled)
  if [[ -z ${configured//[[:space:]]/} ]]; then
    info "yarn.nodemanager.orphaned-app-dirs.reown.command is unset:" \
         "re-owning is off, root-owned trees will not be collected"
  elif [[ $configured == "$REOWN_SCRIPT" ]]; then
    pass "yarn.nodemanager.orphaned-app-dirs.reown.command matches $REOWN_SCRIPT"
  else
    fail "reown.command does not match the script being verified" \
      "configured: $configured" \
      "verified:   $REOWN_SCRIPT" \
      "a mismatch here is the likeliest silent failure of this feature"
  fi
  if [[ ${enabled//[[:space:]]/} != "true" ]]; then
    info "yarn.nodemanager.orphaned-app-dirs.cleanup.enabled is not true:" \
         "the reaper itself is off, so nothing will call the script"
  fi
fi

# --- 10. functional smoke test through the real sudo path -------------------
# Non-mutating: the first call passes no arguments, the second an application id
# that cannot exist. Neither touches a real directory.
if [[ -x $REOWN_SCRIPT ]]; then
  rc=0
  sudo -u "$NM_USER" sudo -n "$REOWN_SCRIPT" >/dev/null 2>&1 || rc=$?
  if [[ $rc -eq 64 ]]; then
    pass "sudo path works: no-argument call was rejected with exit 64"
  elif [[ $rc -eq 1 ]]; then
    fail "sudo refused to run the script as $NM_USER (exit 1)" \
      "check the sudoers rule and that the NodeManager user is $NM_USER" \
      "run: sudo -u $NM_USER sudo -n $REOWN_SCRIPT"
  else
    fail "unexpected exit $rc from the no-argument smoke test (expected 64)" \
      "run: sudo -u $NM_USER sudo -n $REOWN_SCRIPT"
  fi

  probe_user=""
  while IFS= read -r d || [[ -n $d ]]; do
    d=${d//[[:space:]]/}
    [[ -z $d ]] && continue
    d=${d#file://}
    [[ -d $d/usercache ]] || continue
    for candidate in "$d"/usercache/*; do
      [[ -d $candidate ]] || continue
      probe_user=$(basename "$candidate")
      break
    done
    [[ -n $probe_user ]] && break
  done < <(printf '%s' "${local_dirs_raw:-}" | tr ',' '\n')

  if [[ -n $probe_user ]]; then
    rc=0
    sudo -u "$NM_USER" sudo -n "$REOWN_SCRIPT" "$probe_user" \
      application_0_0 >/dev/null 2>&1 || rc=$?
    if [[ $rc -eq 0 ]]; then
      pass "end-to-end call for $probe_user/application_0_0 succeeded" \
           "(nothing to do, no directory touched)"
    else
      fail "end-to-end call exited $rc for $probe_user application_0_0" \
        "run it by hand to see the reason:" \
        "sudo -u $NM_USER sudo -n $REOWN_SCRIPT $probe_user application_0_0" \
        "65 = untrusted configuration, 67 = no usable local dir, 1 = sudo refused"
    fi
  else
    # Not a warning: this is the only check that exercises the whole path, and
    # a green run without it is exactly how a broken deployment slips through.
    fail "no usercache/<user> directory found, so the end-to-end call could not be made" \
      "this is the check that catches a misdeployment; the others test the parts, not the path" \
      "re-run on a node that has actually run containers, then enable the feature"
  fi
else
  warn "$REOWN_SCRIPT is not executable by root, skipping the smoke tests"
fi

# --- 11. optional backlog scan ----------------------------------------------
if [[ $DO_SCAN -eq 1 && -n ${local_dirs_raw:-} ]]; then
  while IFS= read -r d || [[ -n $d ]]; do
    d=${d//[[:space:]]/}
    [[ -z $d ]] && continue
    d=${d#file://}
    for sub in usercache nmPrivate; do
      [[ -d $d/$sub ]] || continue
      # -uid 0 with no -gid: the re-own script filters on the owner alone.
      count=$(find "$d/$sub" -uid 0 2>/dev/null | wc -l | tr -d ' ')
      info "$d/$sub contains $count root-owned entries"
    done
  done < <(printf '%s' "$local_dirs_raw" | tr ',' '\n')
elif [[ $DO_SCAN -eq 1 ]]; then
  warn "--scan requested but no local dirs are known"
fi

printf '\n'
if [[ $fails -gt 0 ]]; then
  printf '%s: %d check(s) FAILED, %d warning(s). Do not enable the feature yet.\n' \
    "$PROG" "$fails" "$warns"
  exit 1
fi
printf '%s: all checks passed, %d warning(s).\n' "$PROG" "$warns"
exit 0
